{
  "expo": {
    "name": "HarvestLink",
    "slug": "harvestlink-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1A531B",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.sanker_protus.harvestlinkmobile",
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "photosPermission": "HarvestLink uses your photos so you can add pictures to your produce listings, profile and dispute evidence.",
          "cameraPermission": "HarvestLink uses your camera so you can take photos as evidence when reporting a delivery problem.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1A531B",
          "image": "./assets/app_logo.png",
          "imageWidth": 160
        }
      ],
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "HarvestLink uses your location to share your delivery position with the buyer or farmer."
        }
      ],
      "@maplibre/maplibre-react-native",
      "@react-native-google-signin/google-signin",
      "expo-splash-screen"
    ],
    "extra": {
      "eas": {
        "projectId": "5bb4b25b-dd9c-401b-accf-4136e4f9ea22"
      }
    },
    "owner": "proman04"
  }
}
