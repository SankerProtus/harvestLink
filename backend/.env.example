# ── Server ────────────────────────────
PORT=3000
NODE_ENV=development


# ── Database ─────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/harvest_link

# ── Auth (JWT) ───────────────────────────
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# ── Payments ────────────────────────────
PAYMENTS_REQUIRED=false
PAYSTACK_SECRET_KEY=

# ── OTP delivery ────────────────────────
SMS_PROVIDER=mock
OTP_DEBUG_EXPOSE=false
ARKESEL_API_KEY=
ARKESEL_SENDER_ID=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Cloudinary (listing/profile photo uploads) ───────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
