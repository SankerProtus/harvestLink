# ── Server ────────────────────────────
PORT=3000
NODE_ENV=development
FRONTEND_URL=
LOG_LEVEL=
ALLOWED_ORIGINS=

# ── Database ─────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/harvest_link

# ── Auth (JWT) ───────────────────────────
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# ── OTP delivery ────────────────────────
SMS_PROVIDER=mock
ARKESEL_API_KEY=
ARKESEL_SENDER_ID=

OTP_DEBUG_EXPOSE=false

# ── Google Sign-In ────────────
GOOGLE_CLIENT_ID=

# ── Cloudinary (listing/profile photo uploads) ───────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── CORS ──────────────
CORS_ORIGIN=
