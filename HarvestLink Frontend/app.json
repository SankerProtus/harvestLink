{
  "expo": {
    "name": "HarvestLink",
    "slug": "harvestlink-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/adaptive-icon.png",
    "splash": {
      "image": "./assets/harvest link logo.jpeg",
      "resizeMode": "contain",
      "backgroundColor": "#2F6B3C"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.harvestlink.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2F6B3C"
      },
      "package": "com.harvestlink.mobile"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-image-picker"
    ],
    "newArchEnabled": false
  }
}
